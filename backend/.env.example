# DevPilot AI — Backend environment variables
# Copy this file to .env and fill in the values.
# Never commit .env with real secrets.

# GitHub personal access token (increases API rate limit from 60 to 5000 req/hr).
# Required for private repositories.
# Generate at: https://github.com/settings/tokens
GITHUB_TOKEN=

# OpenAI API key — when set, GPT-4o-mini generates the onboarding report.
# When absent, a deterministic template renderer is used instead.
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Comma-separated list of allowed CORS origins.
# Defaults to http://localhost:3000 and http://127.0.0.1:3000 when unset.
# In production, set this to your frontend domain, e.g.:
# CORS_ORIGINS=https://devpilot.yourdomain.com
CORS_ORIGINS=
